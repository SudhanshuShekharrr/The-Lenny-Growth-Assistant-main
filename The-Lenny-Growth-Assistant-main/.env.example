# ==============================================================================
# Lenny Growth Assistant — Environment Configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ==============================================================================

# --- App ---
ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173
# Set to "true" to log every SQL query with timing (verbose — dev only)
LOG_SQL=false

# --- Database (required) ---
# Full connection string used by the app (asyncpg driver). When running via
# docker-compose, "postgres" is the service name, so the default below works as-is.
DATABASE_URL=postgresql://lenny:lenny@postgres:5432/lenny_growth_assistant

# Individual fields — used by docker-compose to configure the postgres
# container and must stay in sync with the DATABASE_URL above.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny_growth_assistant

# --- LLM provider toggle (required) ---
# One of: ollama | anthropic | openai
# "ollama" is mandatory for the submitted demo per the assignment brief.
LLM_PROVIDER=ollama

# Local model, run via the "ollama" docker-compose service.
# Pick a model that runs comfortably on your machine, e.g. llama3.1:8b,
# qwen2.5:7b, or mistral:7b.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud provider (optional). Only required if LLM_PROVIDER=anthropic.
# Never commit a real key — this file must only ever contain placeholders.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cloud provider (optional). Only required if LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- RAG ingestion ---
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git